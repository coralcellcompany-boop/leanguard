# SERVER ONLY. Copy to supabase/.env locally; use Supabase secrets in production.
# Never put these values in Flutter --dart-define or commit the populated file.
OPENAI_API_KEY=
OPENAI_COACH_MODEL=gpt-4.1-mini
OPENAI_REASONING_MODEL=gpt-4.1
REVENUECAT_SECRET_KEY=
REVENUECAT_WEBHOOK_SECRET=
ALLOW_SANDBOX_ENTITLEMENTS=false
REMINDER_CRON_SECRET=
# Single-line JSON service account with Firebase Cloud Messaging permission.
FCM_SERVICE_ACCOUNT_JSON=
# Optional exact local browser origin; native apps do not require CORS.
ALLOWED_WEB_ORIGIN=
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected by
# Supabase. Do not override them on the client.
