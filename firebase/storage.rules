rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function owner(uid) { return request.auth != null && request.auth.uid == uid && !firestore.exists(/databases/(default)/documents/account_deletions/$(uid)); }
    match /users/{uid}/avatars/{name} {
      allow read, delete: if owner(uid);
      allow create, update: if owner(uid)
        && request.resource.size < 5 * 1024 * 1024 && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }
    match /users/{uid}/exports/{name} { allow read: if owner(uid); }
    match /exports/{uid}/{name} { allow read: if owner(uid); }
    match /{path=**} { allow read, write: if false; }
  }
}
