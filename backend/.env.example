# Public deployment settings only. Backend secrets are mounted from ./secrets.
API_DOMAIN=api.example.com
ACME_EMAIL=admin@example.com
FIREBASE_PROJECT_ID=leanguard-a58ff
# Explicit browser origins, comma separated. Native mobile needs no Origin.
ALLOWED_ORIGINS=
OPENAI_COACH_MODEL=gpt-4.1-mini
OPENAI_REASONING_MODEL=gpt-4.1
ALLOW_SANDBOX_ENTITLEMENTS=false
# Optional same-VPS landing overlay; build ../landing/dist separately first.
LANDING_DOMAIN=example.com
