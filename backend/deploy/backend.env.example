# Plain Node/systemd template. Copy to /etc/leanguard/backend.env (root:leanguard 0640).
NODE_ENV=production
HOST=127.0.0.1
PORT=8080
TRUST_PROXY_HOPS=1
FIREBASE_PROJECT_ID=leanguard-a58ff
GOOGLE_APPLICATION_CREDENTIALS=/etc/leanguard/secrets/firebase_admin.json
DATABASE_URL_FILE=/etc/leanguard/secrets/database_url
PUBLIC_BASE_URL=https://api.example.com
EXPORT_DIRECTORY=/var/lib/leanguard/exports
EXPORT_SIGNING_SECRET_FILE=/etc/leanguard/secrets/export_signing_secret
OPENAI_API_KEY_FILE=/etc/leanguard/secrets/openai_api_key
REVENUECAT_SECRET_KEY_FILE=/etc/leanguard/secrets/revenuecat_secret_key
REVENUECAT_WEBHOOK_SECRET_FILE=/etc/leanguard/secrets/revenuecat_webhook_secret
OPENAI_COACH_MODEL=gpt-4.1-mini
OPENAI_REASONING_MODEL=gpt-4.1
ALLOW_SANDBOX_ENTITLEMENTS=false
ALLOWED_ORIGINS=
